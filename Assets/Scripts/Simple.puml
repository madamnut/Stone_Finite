@startuml
title Stone - Simple Structure View (Wide Layout)

left to right direction
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 24
skinparam ranksep 34
skinparam packageTitleFontStyle bold
hide empty members
hide circle

package "Core" {
  interface IInventoryOwner
  interface IInventoryOwnerConsumer

  class InventoryData
  class ItemData
  class WorldData
  class EntitySaveData

  IInventoryOwner -[hidden]- IInventoryOwnerConsumer
  InventoryData -[hidden]- ItemData
  ItemData -[hidden]- WorldData
  WorldData -[hidden]- EntitySaveData
}

package "Data" {
  class CellLibrary
  class ItemLibrary
  class RecipeLibrary

  CellLibrary -[hidden]- ItemLibrary
  ItemLibrary -[hidden]- RecipeLibrary
}

package "Support" {
  class Debugger
  class CameraFollow
  class BackGround
  class AudioManager
  class VfxManager
  class RotatingVfx
  class BeltVfx
  class GodRay

  Debugger -[hidden]- CameraFollow
  CameraFollow -[hidden]- BackGround
  BackGround -[hidden]- AudioManager
  VfxManager -[hidden]- RotatingVfx
  RotatingVfx -[hidden]- BeltVfx
  BeltVfx -[hidden]- GodRay
}

package "Player" {
  class Player
  class InteractionController

  class BlockInteractionService
  class UtilityInteractionService
  class GearInteractionService
  class MultiblockInteractionService
  class CorpseInteractionService
  class HeldItemService

  class GroundProbe
  class FluidProbe
  class PickupSensor
  class CombatHitSensor
  class CorpseHoverQueryService
  class PlatformDropThroughService

  Player -[hidden]- InteractionController
  BlockInteractionService -[hidden]- UtilityInteractionService
  UtilityInteractionService -[hidden]- GearInteractionService
  GearInteractionService -[hidden]- MultiblockInteractionService
  MultiblockInteractionService -[hidden]- CorpseInteractionService
  CorpseInteractionService -[hidden]- HeldItemService
  GroundProbe -[hidden]- FluidProbe
  FluidProbe -[hidden]- PickupSensor
  PickupSensor -[hidden]- CombatHitSensor
  CombatHitSensor -[hidden]- CorpseHoverQueryService
  CorpseHoverQueryService -[hidden]- PlatformDropThroughService
}

package "UI" {
  interface ICursorTooltipSource

  class Cursor
  class Hotbar
  class ItemSlot
  class PlayerInventory
  class Heart

  class CraftModule
  class ToolbenchModule
  class BrickFurnaceModule
  class CampfireModule
  class ClayKilnModule
  class CokeOvenModule
  class WoodenCrateModule
  class CrucibleView
  class CrucibleSmelts

  class ModuleSlotSyncUtility

  Cursor -[hidden]- Hotbar
  Hotbar -[hidden]- ItemSlot
  ItemSlot -[hidden]- PlayerInventory
  PlayerInventory -[hidden]- Heart
  CraftModule -[hidden]- ToolbenchModule
  ToolbenchModule -[hidden]- BrickFurnaceModule
