package "World / Gear" {
  class GearNetworkManager
  class GearNetwork
  class GearNode
  class SourceNode
  class BeltLink

  GearNetworkManager -[hidden]- GearNetwork
  GearNetwork -[hidden]- GearNode
  GearNode -[hidden]- SourceNode
  SourceNode -[hidden]- BeltLink
}

package "World / Generation" {
  class WorldDataGenerator
