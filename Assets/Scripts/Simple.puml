package "World / Definitions" {
  class MultiblockLibrary
  class UtilityLibrary
  class WorldGenSettings

  MultiblockLibrary -[hidden]- UtilityLibrary
  UtilityLibrary -[hidden]- WorldGenSettings
}

package "World / Entities" {
  abstract class Entity
  class DroppedItem
  class Corpse
  class Mob
  class Cow
  class FallingBlock
  class EntityManager

  Entity -[hidden]- DroppedItem
  DroppedItem -[hidden]- Corpse
  Corpse -[hidden]- Mob
  Mob -[hidden]- Cow
  Cow -[hidden]- FallingBlock
