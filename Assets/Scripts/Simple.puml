  EntityPersistence -[hidden]- WorldSavePathResolver
}

package "Lobby / Tools" {
  class LobyManager
  class WorldLoadContext
  class ImageGenerator
  class GridGizmo
  class ClassDiagramGenerator
  class ScriptSelectionManager

  LobyManager -[hidden]- WorldLoadContext
  WorldLoadContext -[hidden]- ImageGenerator
  ImageGenerator -[hidden]- GridGizmo
  GridGizmo -[hidden]- ClassDiagramGenerator
  ClassDiagramGenerator -[hidden]- ScriptSelectionManager
}

' package row 1: Core -> Data -> Player -> UI -> Lobby
IInventoryOwner -right[hidden]-> CellLibrary
CellLibrary -right[hidden]-> Player
Player -right[hidden]-> Cursor
Cursor -right[hidden]-> LobyManager

' package row 2: Support -> World definitions/generation/runtime -> entities/factories -> multiblock -> gear
Debugger -right[hidden]-> MultiblockLibrary
MultiblockLibrary -right[hidden]-> WorldDataGenerator
WorldDataGenerator -right[hidden]-> WorldManager
WorldManager -right[hidden]-> ItemDropper
ItemDropper -right[hidden]-> Entity
Entity -right[hidden]-> MultiblockManager
MultiblockManager -right[hidden]-> GearNetworkManager

' connect rows so packages stay grouped in two horizontal bands
CellLibrary -down[hidden]-> MultiblockLibrary
Cursor -down[hidden]-> WorldManager

